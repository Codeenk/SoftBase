# SoftBase — server-side Google Sheets integration
# Copy real values into Vercel project settings (never commit real secrets).
# Full instructions: SPREADSHEET_SETUP.md

# Service account credentials (Google Cloud console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Spreadsheet IDs (from each spreadsheet's URL)
GOOGLE_SHEETS_CLIENT_INQUIRIES_ID=
GOOGLE_SHEETS_INTERNSHIP_APPLICATIONS_ID=

# Optional tab names (defaults shown)
GOOGLE_SHEETS_CLIENT_TAB=Inquiries
GOOGLE_SHEETS_INTERNS_TAB=Applications
